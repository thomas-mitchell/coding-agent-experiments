# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored (see the `.env*` rule in .gitignore) - never commit it.
# ---------------------------------------------------------------------------

# Google AI Studio key for the Gemini Embedding 2 model.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-google-ai-studio-key

# OpenAI key for the Codex-line reasoning model (Responses API).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key

# Supabase project that holds the vector database.
# SUPABASE_SERVICE_ROLE_KEY: Dashboard -> Project Settings -> API keys -> service_role / secret key.
# This key bypasses RLS. It is used server-side only and must never reach the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Tunables (defaults shown; all optional) -------------------------------

# Embedding model and vector width. EMBEDDING_DIMENSIONS must match the
# vector(N) column in the database migration - changing it needs a new migration.
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536

# Codex-line reasoning model (Responses API only) and its reasoning effort.
# Effort: low | medium | high | xhigh
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium

# Folder scanned for source documents, relative to the repo root.
DOCUMENTS_DIR=documents

# Max concurrent embedding requests during ingestion.
EMBED_CONCURRENCY=3
