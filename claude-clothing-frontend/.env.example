# Copy this file to `.env` and fill in the real workflow URL.
#
# HEADS UP: NEXT_PUBLIC_ variables are inlined into the JavaScript bundle at
# build time. Keeping the URL here keeps it out of git, but it is still readable
# by anyone who opens the deployed site's devtools. It is configuration, not a
# secret. To make the endpoint genuinely private, the request has to move behind
# a server-side route handler and drop the NEXT_PUBLIC_ prefix -- see the
# "How the request works" section of the README for the trade-off.
NEXT_PUBLIC_TRYON_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/your-webhook-id

# Supabase auth. Unlike the webhook URL above, the publishable key is *designed*
# to be public -- it identifies the project and nothing more. What actually
# protects the data is row-level security on the tables (see the `profiles`
# migration). Never put the secret/service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Payments. The studio is a one-off A$9.99 charge, taken through a Stripe
# payment link and recorded in Supabase (`payments` and `entitlements`).
#
# The payment link URL is public on purpose -- it is the address we send the
# browser to. The three below it are not, and none of them may ever gain a
# NEXT_PUBLIC_ prefix: the Stripe secret key can move money, and the Supabase
# secret (service_role) key bypasses row-level security entirely. That key is
# the only thing allowed to set `entitlements.has_access`, which is why the
# table has no update policy -- otherwise a user could grant themselves access
# from the browser with the publishable key.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/test_your_link_id
STRIPE_SECRET_KEY=sk_test_...          # sandbox "Nunya" -> Developers -> API keys -> Secret key
# Returned once, when the webhook endpoint is created. Verifies that a webhook
# delivery really came from Stripe -- that check is the only authentication on
# /api/stripe/webhook, which sits outside the login gate.
STRIPE_WEBHOOK_SECRET=whsec_your_signing_secret_here
SUPABASE_SECRET_KEY=sb_secret_...      # Supabase -> Project Settings -> API keys -> service_role
