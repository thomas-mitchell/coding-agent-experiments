# Copy this file to `.env` and fill in the real workflow URL.
#
# HEADS UP: NEXT_PUBLIC_ variables are inlined into the JavaScript bundle at
# build time. Keeping the URL here keeps it out of git, but it is still readable
# by anyone who opens the deployed site's devtools. It is configuration, not a
# secret. To make the endpoint genuinely private, the request has to move behind
# a server-side route handler and drop the NEXT_PUBLIC_ prefix -- see the
# "How the request works" section of the README for the trade-off.
NEXT_PUBLIC_TRYON_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/your-webhook-id

# Supabase auth. Unlike the webhook URL above, the publishable key is *designed*
# to be public -- it identifies the project and nothing more. What actually
# protects the data is row-level security on the tables (see the `profiles`
# migration). Never put the secret/service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
